{
  "version": "v3.0.0",
  "rules": [
    {
      "id": "chess-engine-timeout-warning",
      "name": "Chess Engine Search Timeout (Warning)",
      "description": "Fires when agent.decide_move exceeds 10s, indicating search blowup.",
      "severity": "warning",
      "ruleType": "TRACES_BASED",
      "evalWindow": "5m",
      "disabled": false,
      "query": {
        "queryType": "builder",
        "compositeQuery": {
          "builderQueries": {
            "A": {
              "queryType": "trace_query",
              "query": {
                "op": "lt",
                "items": [],
                "aggregateOperator": "count",
                "filters": {
                  "items": [
                    {
                      "key": "serviceName",
                      "op": "=",
                      "value": "chess-engine-service"
                    },
                    {
                      "key": "name",
                      "op": "=",
                      "value": "agent.decide_move"
                    }
                  ]
                },
                "groupBy": [],
                "orderBy": [],
                "limit": 0
              }
            }
          }
        }
      },
      "condition": {
        "operator": ">",
        "target": "10000"
      },
      "annotations": {
        "summary": "Chess engine search exceeded 10s threshold",
        "runbook": "Check position complexity. Consider reducing engine depth."
      },
      "labels": {
        "team": "chess-engine",
        "severity": "warning"
      }
    },
    {
      "id": "chess-engine-timeout-critical",
      "name": "Chess Engine Search Timeout (Critical)",
      "description": "Fires when agent.decide_move exceeds 30s.",
      "severity": "critical",
      "ruleType": "TRACES_BASED",
      "evalWindow": "5m",
      "disabled": false,
      "query": {
        "queryType": "builder",
        "compositeQuery": {
          "builderQueries": {
            "A": {
              "queryType": "trace_query",
              "query": {
                "op": "lt",
                "items": [],
                "aggregateOperator": "count",
                "filters": {
                  "items": [
                    {
                      "key": "serviceName",
                      "op": "=",
                      "value": "chess-engine-service"
                    },
                    {
                      "key": "name",
                      "op": "=",
                      "value": "agent.decide_move"
                    }
                  ]
                },
                "groupBy": [],
                "orderBy": [],
                "limit": 0
              }
            }
          }
        }
      },
      "condition": {
        "operator": ">",
        "target": "30000"
      },
      "annotations": {
        "summary": "Chess engine search exceeded 30s - likely pathological position",
        "runbook": "Investigate the FEN position. May need depth reduction or pruning fix."
      },
      "labels": {
        "team": "chess-engine",
        "severity": "critical"
      }
    },
    {
      "id": "coach-agent-high-latency",
      "name": "LLM Coach Agent High Latency",
      "description": "Fires when coach.explain span exceeds 15s.",
      "severity": "warning",
      "ruleType": "TRACES_BASED",
      "evalWindow": "5m",
      "disabled": false,
      "query": {
        "queryType": "builder",
        "compositeQuery": {
          "builderQueries": {
            "A": {
              "queryType": "trace_query",
              "query": {
                "op": "lt",
                "items": [],
                "aggregateOperator": "count",
                "filters": {
                  "items": [
                    {
                      "key": "serviceName",
                      "op": "=",
                      "value": "chess-coach-agent"
                    },
                    {
                      "key": "name",
                      "op": "=",
                      "value": "coach.explain"
                    }
                  ]
                },
                "groupBy": [],
                "orderBy": [],
                "limit": 0
              }
            }
          }
        }
      },
      "condition": {
        "operator": ">",
        "target": "15000"
      },
      "annotations": {
        "summary": "Coach agent LLM response time exceeded 15s",
        "runbook": "Check Groq API status. Consider switching to fallback model."
      },
      "labels": {
        "team": "chess-coach",
        "severity": "warning"
      }
    }
  ]
}
